{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node -e \"if (process.env.VERCEL_ENV !== 'preview') { console.error('Preview-only test build'); process.exit(1) }\" && npm run build && node scripts/blob-claims.mjs",
  "outputDirectory": "public",
  "git": {
    "deploymentEnabled": {
      "review/desk-vercel-editor-shell": false,
      "review/original-editor": false
    }
  },
  "functions": {
    "api/desk.mjs": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api/desk"
    }
  ]
}
